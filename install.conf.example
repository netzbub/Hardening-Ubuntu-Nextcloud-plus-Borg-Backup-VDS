# install.conf.example — template for the personal, deployment-specific values.
#
# 1) Copy it:        cp install.conf.example install.conf
# 2) Edit install.conf with YOUR real values.
# 3) install.conf is git-ignored and never uploaded. Keep it next to install.sh,
#    or point install.sh at it:  INSTALL_CONF=/path/to/install.conf ./install.sh ...
#
# NOTE: do not commit real secrets. Clear SMTP_PASS again after the one-time Phase 4 run.
# All values below are placeholders (John Doe style) — replace them.

# --- Required ---
ADMIN_USER="johndoe"                 # sudo admin user / SSH login
SSH_PORT="22022"                     # non-standard SSH port
SSH_PUBKEY="ssh-ed25519 AAAA...replace-with-your-public-key... johndoe-vps"
SSH_CLIENT_KEY="~/.ssh/id_ed25519"   # path to the PRIVATE key on YOUR machine; used only for printed login hints
ADMIN_MAIL="admin@example.com"       # valid address for system mail
HOSTNAME_FQDN="server.example.com"   # optional; leave empty to keep the provider hostname

# --- Nextcloud ---
NC_DOMAIN="next.example.com"
NC_IMAGE_TAG=""                      # current stable tag, e.g. "31" (WITHOUT the -apache suffix)
# NC_DB_IMAGE="mariadb:11.8"         # Rev.13: pinned database line
# NC_REDIS_IMAGE="redis:7.4-alpine"
# NC_DB_BUFFER_POOL="1G"
# NC_PHONE_REGION="DE"
# NC_MAINT_WINDOW="1"                # start hour (UTC) of the maintenance window
# NC_LOGLEVEL="2"                    # fail2ban needs <= 2
# NC_MAIL_FROM="next"                # sender local part; password in $SECRETS_IN_DIR/smtp-next
# NC_MAIL_DOMAIN="example.com"

# --- WireGuard ---
WG_PORT="51820"
WG_NET="10.8.0"                      # /24 appended; server = .1, local machine = .2
WG_CLIENT_PUBKEY=""                  # your local machine's WireGuard public key
# WG_PEERS=""                        # Rev.13: more devices, "name:publickey:lastoctet ..." (3-254)

# --- Mail (msmtp) ---
SMTP_HOST="mail.example.com"
SMTP_PORT="587"
SMTP_USER="admin@example.com"        # often the full address
SMTP_PASS=""                         # ONE-TIME only; clear again after Phase 4
SMTP_FROM="admin@example.com"
# Rev.13: second sender for application alarms; its password goes into
# $SECRETS_IN_DIR/smtp-alarm (one line, root 600), never into this file.
# SMTP_ALARM_FROM="alarm@example.com"
# SECRETS_IN_DIR="/root/install-secrets.in"

# --- Rev.13: accounts, SSH, fail2ban ---
# ADMIN_PW_REMIND_DAYS="182"         # admin password never expires; daily reminder mail from day 182
# ADMIN_PW_REMIND_TO=""              # default: SMTP_ALARM_FROM, else ADMIN_MAIL
# SHELL_TMOUT="900"                  # idle logout of interactive shells, seconds
# SSH_TCP_FORWARDING="no"            # "yes" only if SSH tunnels are really used
# F2B_IGNOREIP=""                    # networks fail2ban never bans, e.g. a fixed office IPv6 /64
# KEEP_SNAPD="no"                    # "yes" keeps snapd for Canonical Livepatch (Ubuntu Pro)
# BORG_TIMER="*-*-* 05:00:00"        # daily server backup

# --- Optional overrides (defaults shown; uncomment to change) ---
# HDD_MOUNT="/srv/hdd"
# TIMEZONE="Europe/Berlin"
# WAN_IF=""                          # empty = auto-detect the WAN interface
# ENABLE_GRUB_HARDENING="no"         # "yes" only with a fresh provider backup
# SWAPFILE_SIZE_GB="0"                # extra swap FILE in whole GB, on top of the
                                     # swap the provider panel reserves at build
                                     # time. 0 = none. Can be raised later without
                                     # a rebuild; swap areas are additive.

# --- Optional phase 13: immo.flow (second PHP project with its own MariaDB) ---
# ENABLE_IMMO="no"
# IMMO_DOMAIN="immo.example.com"
# IMMO_DIR="/srv/immo"
# IMMO_USER="immo"
# IMMO_DB="immo"
# IMMO_DB_USER="immo-user"
# IMMO_RUN_TIME="15:00"              # daily run, server timezone
# IMMO_ONLINE_TIMES="07:00 19:00"    # Rev.13: online check; empty = off
# IMMO_ALARM_TO=""                   # failure mails; default SMTP_ALARM_FROM
# ENABLE_IMMO_PLAYWRIGHT="no"        # ~400 MB disk, ~1 GB RAM while running
# --- mail RETRIEVAL for the daily run (phase 13). No inbound mail server on this box:
#     no MX record, no SMTP acceptance - the mailbox stays at the provider.
# IMAP_HOST="mail.example.com"
# IMAP_PORT="993"                    # 993 = IMAP over TLS. NOT 995, that is POP3 over TLS.
# IMAP_USER="mailbox@example.com"
# IMAP_PASS=""                       # written ONCE to /srv/immo/.env (600), then cleared here
# IMAP_ORDNER="INBOX"
# IMMO_WEB_ENV="/etc/immo/web.env"   # env file for the PHP frontend, WITHOUT the IMAP password
# IMMO_MAIL_FROM=""                  # sender of the "password forgotten" mails

# --- Optional phase 14: further static sites ---
# ENABLE_EXTRA_SITES="no"
# EXTRA_SITES="a.example.com b.example.com"

# --- Optional phase 15: Nextcloud Talk High Performance Backend ---
# ENABLE_TALK_HPB="no"
# TURN_PORT="3478"
# JANUS_RTP_MIN="20000"
# JANUS_RTP_MAX="20100"
# JANUS_IMAGE="canyan/janus-gateway:latest"   # UNVERIFIED - check before first run

# --- Optional phase 16: Euro-Office document server for Nextcloud ---
# Needs an A/AAAA record for EO_DOMAIN pointing at this server, and a running
# Nextcloud stack. The JWT is generated (hex) or an existing one in $EO_DIR/.env is kept.
# ENABLE_OFFICE="no"
# EO_DOMAIN="office.example.com"
# EO_IMAGE="ghcr.io/euro-office/documentserver:v9.3.4-hotfix.1"   # tags start with "v"
# EO_DIR="/srv/eurooffice"
# EO_PORT="8890"
# EO_MEM_LIMIT="6g"

# --- Optional phase 17 (Rev.13): ClamAV for uploads to Nextcloud ---
# ENABLE_CLAMAV="no"
# AV_INFECTED_ACTION="only_log"      # only_log | delete
